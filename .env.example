# ============================================================
# AI Customer Support Dashboard — Environment Variables
# ============================================================
# Copy this file to `.env` (backend) and `frontend/.env.local` (frontend)
# For Vercel, set these in the Vercel Dashboard under Project Settings > Environment Variables.

# ==== BACKEND CONFIGURATION ====
# (Set these on your backend hosting provider: Railway, Render, Fly.io, etc.)
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000           # In production: your Vercel frontend URL (e.g., https://your-app.vercel.app)

# ==== DATABASE (PostgreSQL with pgvector) ====
# Local: postgresql://postgres:postgres@localhost:5432/ai_support_dashboard
# Production: Use a hosted provider (Neon, Supabase, Railway Postgres, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/ai_support_db?schema=public"

# ==== AUTHENTICATION ====
JWT_ACCESS_SECRET="your_super_secret_access_key_development"
JWT_REFRESH_SECRET="your_super_secret_refresh_key_development"

# ==== EXTERNAL APIS ====
GEMINI_API_KEY="your_google_gemini_api_key_placeholder"

# ==== FRONTEND CONFIGURATION ====
# (Set these in Vercel Dashboard OR in frontend/.env.local for local dev)
# NEXT_PUBLIC_ vars are embedded at build time and exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1       # In production: your backend URL (e.g., https://api.your-app.com/api/v1)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000            # In production: your backend URL (e.g., https://api.your-app.com)
